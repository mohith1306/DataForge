# DataForge Environment Configuration

# LLM
GROQ_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=google/gemini-3.6-flash

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@localhost:5432/dataforge

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dataforge

# TrueForge
TRUEFORGE_URL=http://localhost:8790
TRUEFORGE_ENABLED=true

# GitHub (for MCP)
GITHUB_TOKEN=
GITHUB_REPO=mohith1306/DataForge

# Airflow (for pipeline rerun)
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Kubernetes (for rollback)
K8S_ENABLED=false
K8S_NAMESPACE=dataforge
K8S_DEPLOYMENT=dataforge-pipeline

# PagerDuty (for ticketing)
PAGERDUTY_ENABLED=false
PAGERDUTY_ROUTING_KEY=

# Jira (for ticketing)
JIRA_ENABLED=false
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=DATA

# App
DATAFORGE_ENV=demo
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Dev login
DEV_PASSWORD=dataforge-dev-2024

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Default org ID for monitor-created incidents
DEFAULT_ORG_ID=

# Frontend
VITE_API_URL=http://localhost:8000/api
