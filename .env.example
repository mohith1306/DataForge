# DataForge Environment Configuration

# LLM
OPENAI_API_KEY=your-openai-api-key-here
MODEL_NAME=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@localhost:5432/dataforge

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=dataforge

# TrueForge
TRUEFORGE_API_URL=http://localhost:8000
TRUEFORGE_API_KEY=

# GitHub (for MCP)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# App
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
